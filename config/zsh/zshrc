export LS_COLORS

# --------------------------------------------
# Complement
# --------------------------------------------
# 補完機能を有効にする
autoload -Uz compinit

# .zcompdump の格納先 (XDG準拠)
ZSH_COMPDUMP="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump"

# .zcompdumpが作成されていない、もしくは最終更新から24時間以上経過の場合にcompinitを実行する
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+24) ]]; then
  compinit -d "${ZSH_COMPDUMP}"
else
  compinit -C -d "${ZSH_COMPDUMP}"
fi

# 補完候補に色を付ける
zstyle ':completion:*:default' list-colors ${(s.:.)LS_COLORS}

# 補完候補を一覧で表示する(d)
setopt auto_list

# 補完キー連打で補完候補を順に表示する(d)
setopt auto_menu

# 補完候補をできるだけ詰めて表示する
setopt list_packed

# 補完候補にファイルの種類も表示する
setopt list_types

# Shift-Tabで補完候補を逆順する("\e[Z")
bindkey "^[[Z" reverse-menu-complete

# 補完時に大文字小文字を区別しない
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

# 補完リストのカーソル部分をハイライトする
zstyle ':completion:*:default' menu select=2

# 補完関数の表示を強化する
zstyle ':completion:*' verbose yes
zstyle ':completion:*' completer _expand _complete _match _prefix _approximate _list _history
zstyle ':completion:*:messages' format '%F{YELLOW}%d'$DEFAULT
zstyle ':completion:*:warnings' format '%F{RED}No matches for:''%F{YELLOW} %d'$DEFAULT
zstyle ':completion:*:descriptions' format '%F{YELLOW}completing %B%d%b'$DEFAULT
zstyle ':completion:*:options' description 'yes'
zstyle ':completion:*:descriptions' format '%F{yellow}Completing %B%d%b%f'$DEFAULT

# マッチ種別を別々に表示
zstyle ':completion:*' group-name ''

# 今いるディレクトリを補完候補から外す
zstyle ':completion:*' ignore-parents parent pwd ..

# フルパスの時でも今のディレクトリを外す場合の設定
zstyle ':completion:*' ignore-parents parent pwd

# cd -<Tab> で今までに行ったディレクトリを表示かつ移動
setopt auto_pushd

# --------------------------------------------
# 外部コマンドの補完
# --------------------------------------------
# 補完スクリプトのキャッシュディレクトリ
ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
[[ -d "$ZSH_CACHE_DIR" ]] || mkdir -p "$ZSH_CACHE_DIR"

# 補完をキャッシュ経由でロードするヘルパー関数
# Usage: load_completion <コマンド名> <生成コマンド>
load_completion() {
  local cmd="$1"
  local gen_cmd="$2"
  local cache_file="${ZSH_CACHE_DIR}/${cmd}_completion.zsh"

  if type "$cmd" >/dev/null 2>&1; then
    # キャッシュが存在しない、またはコマンド本体より古い場合は再生成
    if [[ ! -f "$cache_file" ]] || [[ "$(command -v $cmd)" -nt "$cache_file" ]]; then
      eval "$gen_cmd" > "$cache_file"
    fi
    source "$cache_file"
  fi
}

# 各種コマンドの補完をキャッシュ経由でロード
load_completion kubectl      "kubectl completion zsh"
load_completion containerlab "containerlab completion zsh"
load_completion uv           "uv generate-shell-completion zsh"
load_completion uvx          "uvx --generate-shell-completion zsh"

# --------------------------------------------
# Glob
# --------------------------------------------
# グロブ機能を拡張する
setopt extended_glob

# ファイルグロブで大文字小文字を区別しない
unsetopt caseglob

# --------------------------------------------
# Zoxide (smarter cd)
# --------------------------------------------
if type zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# --------------------------------------------
# Prompt
# --------------------------------------------
# Starship
if type starship >/dev/null 2>&1; then
  export STARSHIP_CONFIG="${HOME}/.dotfiles/config/zsh/starship.toml"
  eval "$(starship init zsh)"
else
  # マニュアル (NerdFontが使えない環境で利用)
  source "${HOME}/.dotfiles/config/zsh/prompt.rc.zsh"
fi
