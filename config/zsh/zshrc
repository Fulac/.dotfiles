LS_COLORS+=':mi=01;38;5;208'  # missing target: 太字+オレンジ
LS_COLORS+=':pi=33'           # named pipe: 黄
LS_COLORS+=':so=01;35'        # socket: 太字+マゼンタ
LS_COLORS+=':do=01;35'        # door (Solaris): 太字+マゼンタ
LS_COLORS+=':bd=01;33'        # block device: 太字+黄
LS_COLORS+=':cd=01;33'        # character device: 太字+黄
LS_COLORS+=':ex=01;32'        # executable: 太字+緑

